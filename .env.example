# ─── Database ────────────────────────────────────────────────────────────────
# Neon Postgres connection string (use the POOLED connection string).
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# ─── Auth (Better Auth) ──────────────────────────────────────────────────────
# Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=""
# Canonical app URL. Locally: http://localhost:3000 · Prod: https://your-app.vercel.app
# On Vercel this can be inferred from VERCEL_URL, but set it explicitly in production.
BETTER_AUTH_URL="http://localhost:3000"

# ─── Cron / sync protection ──────────────────────────────────────────────────
# Bearer token required to call /api/cron/sync. Vercel Cron sends it automatically.
# Generate: openssl rand -base64 32
CRON_SECRET=""

# ─── Presto EPOS API ─────────────────────────────────────────────────────────
PRESTO_BASE_URL=""
PRESTO_API_KEY=""
PRESTO_API_SECRET=""
# Per-location Presto site identifiers
PRESTO_LOCATION_ID_HYDE_PARK=""
PRESTO_LOCATION_ID_GRAND_ARCADE=""

# ─── Shipday (delivery) API ──────────────────────────────────────────────────
SHIPDAY_API_KEY=""

# ─── Google Sheets (item costing) ────────────────────────────────────────────
GOOGLE_SERVICE_ACCOUNT_EMAIL=""
# Paste the full private key. Keep the surrounding quotes; escape newlines as \n.
GOOGLE_PRIVATE_KEY=""
# The spreadsheet ID from the sheet URL (.../spreadsheets/d/<THIS>/edit)
GOOGLE_SHEET_ID=""

# ─── Google Sheets (pricing engine) ──────────────────────────────────────────
# Separate workbook from the costing sheet: per-store tabs (Hyde Park / Grand
# Arcade), each with an INSTORE PRICING and a PLATFORM PRICING section plus a
# COMMERCIAL SETTINGS block (target FC %, platform commission %, meal uplift).
# The spreadsheet ID is the part of the URL between /d/ and /edit.
GOOGLE_PRICING_SHEET_ID=""
# OPTIONAL — only if the pricing sheet uses a DIFFERENT service account from the
# costing sheet. Leave both blank to reuse GOOGLE_SERVICE_ACCOUNT_EMAIL /
# GOOGLE_PRIVATE_KEY above (the simpler setup: just share the pricing sheet with
# the existing service account as Viewer).
GOOGLE_PRICING_SERVICE_ACCOUNT_EMAIL=""
GOOGLE_PRICING_PRIVATE_KEY=""
